@model NotepadApp.Models.Note
@{
    ViewData["Title"] = "New Note";
}

<div class="page-header">
    <h2><i class="bi bi-plus-circle me-2" style="color:var(--accent)"></i>New <span>Note</span></h2>
    <a asp-action="Index" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="page-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label class="form-label-dark">Title</label>
            <input asp-for="Title" class="form-control-dark" placeholder="Enter note title..." />
            <span asp-validation-for="Title" style="color:var(--danger);font-size:0.82rem;"></span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <label class="form-label-dark">Category</label>
                <input asp-for="Category" class="form-control-dark" list="catList" placeholder="e.g. Work, Personal..." />
                <datalist id="catList">
                    <option value="General" />
                    <option value="Work" />
                    <option value="Personal" />
                    <option value="Ideas" />
                    <option value="Todo" />
                </datalist>
            </div>
            <div class="col-md-7 d-flex align-items-end pb-1">
                <label class="d-flex align-items-center gap-2" style="cursor:pointer;color:var(--text-muted);">
                    <input asp-for="IsPinned" type="checkbox" class="check-accent" />
                    <span><i class="bi bi-pin-fill me-1" style="color:var(--accent)"></i>Pin this note</span>
                </label>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label-dark">Content</label>
            <textarea asp-for="Content" class="form-control-dark" rows="14" placeholder="Write your note here..."></textarea>
        </div>

        <hr class="divider" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn-accent"><i class="bi bi-save me-1"></i>Save Note</button>
            <a asp-action="Index" class="btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
