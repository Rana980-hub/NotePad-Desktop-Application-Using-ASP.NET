@model NotepadApp.Models.Note
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-header">
    <h2>
        @if (Model.IsPinned) { <i class="bi bi-pin-fill me-2" style="color:var(--accent)"></i> }
        <span>@Model.Title</span>
    </h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-accent"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="page-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <span class="cat-badge" style="font-size:0.85rem;padding:0.35rem 0.9rem;">
            <i class="bi bi-tag me-1"></i>@Model.Category
        </span>
        <div style="color:var(--text-muted);font-size:0.82rem;">
            <i class="bi bi-clock me-1"></i>Updated: @Model.UpdatedAt.ToString("MMM dd, yyyy — hh:mm tt")
        </div>
    </div>

    <div class="note-content-view">@Model.Content</div>

    <hr class="divider" />

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <small style="color:var(--text-muted);font-size:0.8rem;">
            <i class="bi bi-calendar3 me-1"></i>Created: @Model.CreatedAt.ToString("MMM dd, yyyy — hh:mm tt")
        </small>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-danger-soft" style="font-size:0.85rem;">
            <i class="bi bi-trash me-1"></i>Delete
        </a>
    </div>
</div>
