@model NotepadApp.Models.Note
@{
    ViewData["Title"] = "Delete Note";
}

<div class="page-header">
    <h2><i class="bi bi-trash me-2" style="color:var(--danger)"></i>Delete <span>Note</span></h2>
    <a asp-action="Index" class="btn-ghost"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="page-card" style="border-color:rgba(224,82,82,0.3);">
    <div class="alert-dark-danger mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <span>This action is <strong>permanent</strong> and cannot be undone.</span>
    </div>

    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="cat-badge">@Model.Category</span>
            @if (Model.IsPinned) { <span class="cat-badge"><i class="bi bi-pin-fill me-1"></i>Pinned</span> }
        </div>
        <h4 style="color:var(--text-primary);font-weight:700;">@Model.Title</h4>
        <p style="color:var(--text-muted);font-size:0.9rem;line-height:1.6;">
            @(Model.Content.Length > 200 ? Model.Content[..200] + "..." : Model.Content)
        </p>
    </div>

    <hr class="divider" />

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn-danger-soft"><i class="bi bi-trash me-1"></i>Yes, Delete</button>
            <a asp-action="Index" class="btn-ghost">Cancel</a>
        </div>
    </form>
</div>
