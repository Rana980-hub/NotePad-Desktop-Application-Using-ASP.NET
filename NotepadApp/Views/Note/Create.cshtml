@model NotepadApp.Models.Note
@{
    ViewData["Title"] = "New Note";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold"><i class="bi bi-plus-circle me-2"></i>New Note</h3>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold"></label>
                <input asp-for="Title" class="form-control form-control-lg" placeholder="Note title..." />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <input asp-for="Category" class="form-control" list="categoryList" placeholder="e.g. Work, Personal..." />
                    <datalist id="categoryList">
                        <option value="General" />
                        <option value="Work" />
                        <option value="Personal" />
                        <option value="Ideas" />
                        <option value="Todo" />
                    </datalist>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="IsPinned" class="form-check-input" type="checkbox" />
                        <label asp-for="IsPinned" class="form-check-label">Pin this note</label>
                    </div>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="Content" class="form-label fw-semibold"></label>
                <textarea asp-for="Content" class="form-control" rows="12" placeholder="Write your note here..."></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Save Note</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
