@model List<NotepadApp.Models.Note>
@{
    ViewData["Title"] = "My Notepad";
    var pinned = Model.Where(n => n.IsPinned).ToList();
    var others = Model.Where(n => !n.IsPinned).ToList();
}

<div class="page-header">
    <h2><i class="bi bi-journal-richtext me-2" style="color:var(--accent)"></i>My <span>Notes</span></h2>
    <a asp-action="Create" class="btn-accent"><i class="bi bi-plus-lg me-1"></i>New Note</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-dark-success mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}

<!-- Search & Filter -->
<div class="row g-2 mb-4">
    <div class="col-md-6">
        <form asp-action="Index" method="get" id="searchForm" class="d-flex gap-2">
            <input type="text" name="search" id="searchInput" value="@ViewBag.Search"
                   class="search-bar" placeholder="Search by title or content..." />
            <select name="category" class="filter-select" onchange="document.getElementById('searchForm').submit()">
                <option value="">All Categories</option>
                @foreach (var cat in (List<string>)ViewBag.Categories)
                {
                    <option value="@cat" selected="@(ViewBag.Category == cat ? "selected" : null)">@cat</option>
                }
            </select>
        </form>
    </div>
    <div class="col-md-6 d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
        @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Category as string))
        {
            <a asp-action="Index" class="btn-ghost" style="font-size:0.85rem;">
                <i class="bi bi-x me-1"></i>Clear
            </a>
        }
        <div class="stats-bar">
            Total: <span>@Model.Count</span> &nbsp;|&nbsp; Pinned: <span>@pinned.Count</span>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-journal-x"></i>
        <p>No notes found. <a asp-action="Create">Create your first note!</a></p>
    </div>
}
else
{
    @if (pinned.Any())
    {
        <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-pin-fill" style="color:var(--accent)"></i>
            <span style="color:var(--accent);font-size:0.78rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;">Pinned</span>
            <hr class="divider flex-grow-1 m-0" />
        </div>
        <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
            @foreach (var note in pinned)
            {
                <div class="col">
                    <div class="note-card h-100 pinned">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="cat-badge">@note.Category</span>
                            <form asp-action="TogglePin" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@note.Id" />
                                <button type="submit" class="pin-btn pinned" title="Unpin">
                                    <i class="bi bi-pin-fill"></i>
                                </button>
                            </form>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@note.Title</h5>
                            <p class="card-text">@(note.Content.Length > 110 ? note.Content[..110] + "..." : note.Content)</p>
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center">
                            <small style="color:var(--text-muted);font-size:0.78rem;">
                                <i class="bi bi-clock me-1"></i>@note.UpdatedAt.ToString("MMM dd, yyyy")
                            </small>
                            <div class="card-actions d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@note.Id" class="btn-icon" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@note.Id" class="btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@note.Id" class="btn-icon del" title="Delete"><i class="bi bi-trash"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (others.Any())
    {
        @if (pinned.Any())
        {
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-journal-text" style="color:var(--text-muted)"></i>
                <span style="color:var(--text-muted);font-size:0.78rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;">All Notes</span>
                <hr class="divider flex-grow-1 m-0" />
            </div>
        }
        <div class="row row-cols-1 row-cols-md-3 g-3">
            @foreach (var note in others)
            {
                <div class="col">
                    <div class="note-card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="cat-badge">@note.Category</span>
                            <form asp-action="TogglePin" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@note.Id" />
                                <button type="submit" class="pin-btn" title="Pin">
                                    <i class="bi bi-pin-fill"></i>
                                </button>
                            </form>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@note.Title</h5>
                            <p class="card-text">@(note.Content.Length > 110 ? note.Content[..110] + "..." : note.Content)</p>
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center">
                            <small style="color:var(--text-muted);font-size:0.78rem;">
                                <i class="bi bi-clock me-1"></i>@note.UpdatedAt.ToString("MMM dd, yyyy")
                            </small>
                            <div class="card-actions d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@note.Id" class="btn-icon" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@note.Id" class="btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@note.Id" class="btn-icon del" title="Delete"><i class="bi bi-trash"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@section Scripts {
<script>
    let timer;
    document.getElementById('searchInput').addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(() => document.getElementById('searchForm').submit(), 400);
    });
</script>
}
