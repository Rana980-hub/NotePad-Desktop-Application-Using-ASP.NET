@model List<NotepadApp.Models.Note>
@{
    ViewData["Title"] = "My Notepad";
}

<div class="notepad-header d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-journal-text me-2"></i>My Notepad</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Note</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-md-8">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search notes..." />
            <select name="category" class="form-select w-auto">
                <option value="">All Categories</option>
                @foreach (var cat in (List<string>)ViewBag.Categories)
                {
                    <option value="@cat" selected="@(ViewBag.Category == cat ? "selected" : null)">@cat</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Category as string))
            {
                <a asp-action="Index" class="btn btn-outline-danger"><i class="bi bi-x"></i></a>
            }
        </form>
    </div>
    <div class="col-md-4 text-end text-muted small pt-2">
        @Model.Count note(s) found
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-journal-x" style="font-size:3rem;"></i>
        <p class="mt-3">No notes yet. <a asp-action="Create">Create your first note!</a></p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var note in Model)
        {
            <div class="col">
                <div class="card h-100 note-card @(note.IsPinned ? "border-warning" : "")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="badge bg-secondary">@note.Category</span>
                        <form asp-action="TogglePin" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@note.Id" />
                            <button type="submit" class="btn btn-sm btn-link p-0 @(note.IsPinned ? "text-warning" : "text-muted")" title="@(note.IsPinned ? "Unpin" : "Pin")">
                                <i class="bi bi-pin-fill"></i>
                            </button>
                        </form>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@note.Title</h5>
                        <p class="card-text text-muted small">
                            @(note.Content.Length > 100 ? note.Content.Substring(0, 100) + "..." : note.Content)
                        </p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <small class="text-muted">@note.UpdatedAt.ToString("MMM dd, yyyy")</small>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Details" asp-route-id="@note.Id" class="btn btn-outline-info" title="View"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@note.Id" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@note.Id" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
