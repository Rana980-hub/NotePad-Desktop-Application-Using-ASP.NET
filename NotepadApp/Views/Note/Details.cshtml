@model NotepadApp.Models.Note
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold">
        @if (Model.IsPinned) { <i class="bi bi-pin-fill text-warning me-2"></i> }
        @Model.Title
    </h3>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between">
        <span class="badge bg-secondary fs-6">@Model.Category</span>
        <small class="text-muted">Updated: @Model.UpdatedAt.ToString("MMM dd, yyyy hh:mm tt")</small>
    </div>
    <div class="card-body p-4">
        <pre class="note-content">@Model.Content</pre>
    </div>
    <div class="card-footer text-muted small">
        Created: @Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
    </div>
</div>
